{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,ts}", "tests/helpers/acquisition-crash-child.ts", "tests/helpers/proposal-crash-child.ts", "tests/helpers/bt-swarm.mjs"],
      "project": ["scripts/**/*.{mjs,ts}", "tests/**/*.{ts,tsx,mjs}"],
      "ignoreDependencies": ["sharp", "fflate", "@napi-rs/canvas", "@tiptap/core", "bencode", "create-torrent", "bittorrent-tracker", "webtorrent", "@electron-forge/cli", "electron"]
    },
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/preload/preload.ts", "src/main/parse-worker.ts", "src/renderer/main.tsx", "forge.config.ts", "vite.*.config.ts", "danmaku-define.ts"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"],
      "ignore": ["src/renderer/pdf-worker-types.ts"],
      "ignoreDependencies": ["better-sqlite3", "@electron-forge/plugin-fuses"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/app-core": {
      "entry": ["src/parse-worker.ts", "src/crash-child.ts", "src/voice/vad-worker.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/metadata/bangumi-openapi.ts"],
      "ignoreDependencies": ["onnxruntime-web", "pdfjs-dist"]
    },
    "plugins/*": {
      "entry": ["src/main.mjs", "stubs/*.mjs"],
      "project": ["src/**/*.mjs", "stubs/*.mjs"],
      "ignoreDependencies": ["parse-torrent", "bittorrent-tracker"]
    }
  },
  "ignoreBinaries": ["electron-forge"]
}
